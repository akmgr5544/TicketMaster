# Copy to .env (gitignored) and fill in real values. docker compose interpolates these.
#
# Generate a signing key:  openssl rand -hex 64
# The same value must sign and validate tokens, so keep it stable across the Users service instances.

USERS_AUTH_TOKEN=

# Postgres password, shared by the Users, Bookings and Payments databases on the one server.
POSTGRES_PASSWORD=postgres

# Stripe test-mode credentials for PaymentSystem (dashboard → Developers → API keys / Webhooks).
# PaymentSystem refuses to start without both.
PAYMENTS_STRIPE_SECRET_KEY=
PAYMENTS_STRIPE_WEBHOOK_SECRET=
