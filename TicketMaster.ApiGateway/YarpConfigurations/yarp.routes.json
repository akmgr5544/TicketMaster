{
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "bookings-route": {
        "ClusterId": "bookings-cluster",
        "AuthorizationPolicy": "GatewayAuthPolicy",
        "Match": {
          "Path": "/bookings-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "events-route": {
        "ClusterId": "events-cluster",
        "AuthorizationPolicy": "GatewayAuthPolicy",
        "Match": {
          "Path": "/events-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "payments-webhooks-route": {
        "ClusterId": "payments-cluster",
        "Order": -1,
        "Match": {
          "Path": "/payments-service/api/payments/webhooks/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "api/payments/webhooks/{**catch-all}"
          }
        ]
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "AuthorizationPolicy": "GatewayAuthPolicy",
        "Match": {
          "Path": "/payments-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      }
    }
  }
}
