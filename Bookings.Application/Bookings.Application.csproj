<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
      <!-- Command handlers are internal by architecture rule; the tests still need to construct them. -->
      <InternalsVisibleTo Include="BookingIntegration" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="DistributedLock.Redis" />
      <!-- Grpc.AspNetCore brings this on the server side; Grpc.Net.ClientFactory does not, and the
           generated message types need it. -->
      <PackageReference Include="Google.Protobuf" />
      <PackageReference Include="Grpc.Net.ClientFactory" />
      <PackageReference Include="Grpc.Tools">
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="MediatR" />
      <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
      <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
      <PackageReference Include="Newtonsoft.Json" />
      <PackageReference Include="WolverineFx" />
      <PackageReference Include="WolverineFx.EntityFrameworkCore" />
      <PackageReference Include="WolverineFx.Postgresql" />
      <PackageReference Include="WolverineFx.RabbitMQ" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Bookings.Sql\Bookings.Sql.csproj" />
      <ProjectReference Include="..\TicketMaster.Common\TicketMaster.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- Client half only: Bookings calls this contract, it does not implement it. -->
      <Protobuf Include="..\TicketMaster.Common\Protos\events.proto"
                ProtoRoot="..\TicketMaster.Common\Protos"
                GrpcServices="Client" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Pipelines\" />
      <Folder Include="QueryHandlers\" />
    </ItemGroup>

</Project>
