<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The caller half of the seam: the real EventsService client. Referenced globally. -->
        <ProjectReference Include="..\..\..\Bookings.Application\Bookings.Application.csproj"/>
        <!-- The callee half: the real EventsLookupService + DomainExceptionInterceptor. Aliased,
             because events.proto is generated into BOTH this assembly and Bookings.Application, so
             the message types (GetEventRequest, GetEventReply, Venue) collide by namespace unless one
             side is put behind an extern alias. -->
        <ProjectReference Include="..\..\..\Events.Api\Events.Api.csproj">
            <Aliases>EventsApi</Aliases>
        </ProjectReference>
    </ItemGroup>

</Project>
