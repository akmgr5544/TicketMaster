<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\TicketMaster.ApiGateway\TicketMaster.ApiGateway.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Program.cs loads these relative to the content root; the fixture points the content root at
             the test output, so copy them there rather than chasing the gateway project directory. -->
        <Content Include="..\..\..\TicketMaster.ApiGateway\YarpConfigurations\*.json"
                 Link="YarpConfigurations\%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
